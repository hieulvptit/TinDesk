[Unit]
Description=RemoteVNC outbound network agent
Wants=network-online.target remotevnc-seat-helper.service
After=network-online.target remotevnc-seat-helper.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=remotevnc-agent
Group=remotevnc-agent
StateDirectory=remotevnc-agent
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/remotevnc-agent run --config /etc/remotevnc/agent.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillMode=control-group
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
