# Copy OUTSIDE git; chmod0600. File paths only here; secret contents never in .env.
REMOTEVNC_PUBLIC_ORIGIN=https://amio.vnoffice.io.vn
REMOTEVNC_GOOGLE_REDIRECT_URI=https://amio.vnoffice.io.vn/login/callback
REMOTEVNC_GOOGLE_CLIENT_ID=replace-with-registered-client-id
REMOTEVNC_TURN_KEY_ID=replace-with-turn-key-id
REMOTEVNC_DATA_DIR=/srv/remotevnc/data
REMOTEVNC_GOOGLE_SECRET_FILE=/srv/remotevnc/secrets/google-client-secret
REMOTEVNC_TURN_TOKEN_FILE=/srv/remotevnc/secrets/turn-api-token
